[Unit]
Description=govee-cli serve (Govee lamp daemon)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/govee serve
EnvironmentFile=-%h/.config/govee-cli/env
# To skip tokens on trusted networks, add GOVEE_TRUSTED_NETWORKS=lan,tailscale to the env file.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
